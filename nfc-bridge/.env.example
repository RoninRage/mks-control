GATEWAY_URL=http://localhost:3000
POST_PATH=/api/auth/tag
READER_POST_PATH=/api/auth/reader
DEVICE_ID=kiosk-01
SOURCE=acr122u
DEBOUNCE_MS=800

# Every reader needs a key, otherwise the backend refuses its scans:
# - machine terminal (one Pi per machine): the key shown once when the terminal was created
#   under "Terminals" in the admin UI
TERMINAL_TOKEN=
# - entrance reader: the same ENTRANCE_KEY as in the backend's .env
ENTRANCE_KEY=mke_dev-entrance-key
