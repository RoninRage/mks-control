# Admin RFID Tag UIDs (comma-separated)
# Example: ADMIN_TAG_UIDS=04A224B1C8,04B335C2D9
ADMIN_TAG_UIDS=2659423e,ab9c423e

# Server Port
PORT=3000

# CouchDB Configuration
COUCHDB_URL=http://localhost:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=password
COUCHDB_DB_NAME=mks_members

# Seed default data (areas/equipment/members)
SEED_DATA=false

# Seed mode: default | mass
SEED_MODE=default

# Mass seed counts (used when SEED_MODE=mass)
SEED_MEMBERS=150
SEED_AREAS=20
SEED_EQUIPMENT=200

# Shelly devices
# Password set on the Shellys (same for all devices). Only sent when a device asks for it.
SHELLY_PASSWORD=
# Gen1 devices let you choose the user name; Gen2+ always use "admin".
SHELLY_GEN1_USER=admin
# Request timeout per device call in milliseconds
SHELLY_TIMEOUT_MS=3000

# Machine terminals: logged in at a Pi without activity for this long → logged out (ms)
TERMINAL_IDLE_TIMEOUT_MS=300000

# Machine releases (docs/shelly-plan.md)
COUCHDB_USAGE_DB_NAME=mks_usage
# A Pi that does not call in for this long counts as offline; its machine then runs until the
# Shelly's safety timer ends (ms)
TERMINAL_OFFLINE_AFTER_MS=60000
# Ended machine usages are deleted after this many days (0 = keep forever)
USAGE_RETENTION_DAYS=365

# Shelly monitoring (docs/shelly-plan.md, phase 6)
# How often all Shellys are checked for online/offline (ms)
SHELLY_HEALTH_INTERVAL_MS=30000
# URL under which the Shellys reach this backend, e.g. http://192.168.1.10:3000.
# When set, Gen2+ Shellys report safety input changes immediately (webhooks).
SHELLY_CALLBACK_URL=
# Shared secret of the discovery relay (shelly-discovery container). Empty = reports refused.
SHELLY_DISCOVERY_TOKEN=
# Search the network for Shellys from the backend itself (only works on the host network,
# e.g. in development)
SHELLY_DISCOVERY_MDNS=false
SHELLY_DISCOVERY_INTERVAL_MS=60000

# Login (docs/auth-plan.md)
# Key of the entrance reader (nfc-bridge) and the kiosk browser there, e.g. "mke_" plus
# `openssl rand -hex 32`. Without it nobody can log in at the entrance. The value below is only
# for development (enter it under "Eingang einrichten" on the start page); production uses its
# own key in /opt/mks/.env.
ENTRANCE_KEY=mke_dev-entrance-key
# Kiosk at the entrance: logged out after this long without activity (ms)
SESSION_IDLE_TIMEOUT_MS=300000
# Longest session at the kiosk / on a phone (ms)
SESSION_ENTRANCE_MAX_MS=43200000
SESSION_WEBNFC_MAX_MS=28800000
# Login with the phone (Web NFC). Admin tags from ADMIN_TAG_UIDS never work there.
WEBNFC_LOGIN=true
# Failed phone logins (unknown tags) allowed per minute, for all phones together
WEBNFC_FAILURE_LIMIT=10
